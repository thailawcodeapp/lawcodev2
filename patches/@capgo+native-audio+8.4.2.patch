+
+    private static final String TAG = "SpeechText";
+
+    private final Context context;
+    // Book key -> hash -> text. A book that failed to load is stored as null so
+    // a missing or corrupt asset is not re-read and re-parsed on every
+    // paragraph for the rest of the session.
+    private final Map<String, Map<String, String>> books = new HashMap<>();
+
+    SpeechText(Context context) {
+        this.context = context;
+    }
