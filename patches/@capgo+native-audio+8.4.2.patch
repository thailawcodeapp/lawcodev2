index 0000000..fc158da
--- /dev/null
+++ b/node_modules/@capgo/native-audio/android/src/main/java/ee/forgr/audio/PlaybackForegroundService.java
@@ -0,0 +1,156 @@
+package ee.forgr.audio;
+
+// PATCH — new file, not present in the upstream @capgo/native-audio package.
+//
+// Gives NativeAudio's notification real standing with Android, instead of it
+// just LOOKING like a media player's persistent notification. Stock
+// NativeAudio posts its notification with plain NotificationManagerCompat —
+// which works, visually — but declares no foreground service alongside it.
+// Android does not grant the elevated process priority and network exemption
+// that come with being a foreground service just because a notification is
+// showing; it grants that to a process that has actually told the OS "I am a
+// foreground service, of this specific type." Without that declaration,
+// Android eventually classes the process as idle once the screen has been off
+// for a few minutes and starts restricting its background network — which is
+// what turned a queued paragraph's download, well into a listening session,
+// into a DNS resolution failure ("Unable to resolve host ...r2.dev") while
+// the device still reported a full signal. The process, not the phone, had
+// been cut off.
+//
+// Deliberately thin. It owns no playback state and holds no reference to any
+// audio asset — NativeAudio remains the only thing that knows what is
+// playing, what is queued, or what to do when a lock-screen button is
+// pressed. This class's only two jobs:
+//
+//   1. Exist, carrying the manifest-declared
+//      android:foregroundServiceType="mediaPlayback", so the OS grants the
+//      process the standing that type carries. (See the plugin's
+//      AndroidManifest.xml, also patched, for the matching <service> and the
+//      FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK permissions —
+//      Android 14 requires both the manifest type and a same-typed
+//      startForeground() call to agree.)
+//   2. Hold whatever Notification NativeAudio most recently built, via
+//      startForeground() — which is not only how a foreground service is
+//      created but also the documented way media apps UPDATE one, so posting
+//      a fresh notification every paragraph costs nothing beyond what
+//      NativeAudio already did with NotificationManagerCompat before this
+//      file existed.
+//
+// A static instance reference is a plain, deliberate simplification rather
+// than an oversight: this service exists for exactly one reason (this
+// plugin's own playback), is never bound by anything, and nothing outside
+// this package touches it. NativeAudio starts and stops it by Intent, same as
+// any other service, and hands it notifications through the static promote()
+// call below rather than through a ServiceConnection — binding would add a
+// round trip this one-directional relationship has no use for.
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.IBinder;
+import androidx.annotation.Nullable;
+import androidx.core.app.NotificationCompat;
+
+public class PlaybackForegroundService extends android.app.Service {
+
+    private static volatile PlaybackForegroundService instance;
+
+    /**
+     * Hand a freshly built notification to the running service, if there is
+     * one.
+     *
+     * @return true if a running service took the notification (the caller's
+     *         job is done); false if none is running, meaning the caller
+     *         should fall back to posting it directly. NativeAudio.
+     *         postNotification() is the sole caller and does exactly that.
+     */
+    static boolean promote(Notification notification) {
+        PlaybackForegroundService current = instance;
+        if (current == null) return false;
+        current.show(notification);
+        return true;
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        instance = this;
+        // Must happen here, synchronously, and promptly: Android requires
+        // startForeground() within moments of the service being started, or
+        // it kills the process outright — a hard requirement since Android 8,
+        // tightened further per FGS type on Android 14. NativeAudio's
+        // executePlay() always calls updateNotification() (which calls
+        // promote() above) on the very same thread, before it ever asks this
+        // service to start — but that call reaches the notification tray via
+        // the plain-notify() fallback in that instant, because this instance
+        // does not exist to intercept it yet. This placeholder is what
+        // satisfies Android's timing requirement for THIS moment; the very
+        // next paragraph's updateNotification() replaces it, so what a
+        // listener sees is a real notification, briefly a generic one on the
+        // first paragraph of a session, then the real one again — not a
+        // recurring flash.
+        show(placeholderNotification());
+    }
+
+    @Override
+    public int onStartCommand(android.content.Intent intent, int flags, int startId) {
+        // Not sticky: everything this service exists to protect — the
+        // playlist, the position in it, which voice was chosen — lives in the
+        // JavaScript engine inside the WebView. If Android kills this process,
+        // that state is gone regardless of whether this service comes back,
+        // so restarting it alone (with a null intent, and nothing left to
+        // play) would only leave an orphaned notification with no player
+        // behind it.
+        return START_NOT_STICKY;
+    }
+
+    @Nullable
+    @Override
+    public IBinder onBind(android.content.Intent intent) {
+        return null; // never bound — see the class comment
+    }
+
+    @Override
+    public void onDestroy() {
+        if (instance == this) instance = null;
+        stopForeground(STOP_FOREGROUND_REMOVE);
+        super.onDestroy();
+    }
+
+    private void show(Notification notification) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            startForeground(NativeAudio.NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK);
+        } else {
+            startForeground(NativeAudio.NOTIFICATION_ID, notification);
+        }
+    }
+
+    private Notification placeholderNotification() {
+        ensureChannel();
+        return new NotificationCompat.Builder(this, NativeAudio.CHANNEL_ID)
+            .setSmallIcon(android.R.drawable.ic_media_play)
+            .setContentTitle("กำลังเล่นเสียง")
+            .setPriority(NotificationCompat.PRIORITY_LOW)
+            .setOnlyAlertOnce(true)
+            .build();
+    }
+
+    // Defensive, not required in the ordinary path: NativeAudio.configure()
+    // already creates this channel before any playback can start, so this
+    // service is not usually the first thing to reach for it. Channel
+    // creation is idempotent — the system no-ops a second call with the same
+    // id and settings — so guaranteeing it here too costs nothing and closes
+    // the one path where it would matter: this service being started before
+    // NativeAudio.configure() ever ran.
+    private void ensureChannel() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationChannel channel = new NotificationChannel(NativeAudio.CHANNEL_ID, "Audio Playback", NotificationManager.IMPORTANCE_LOW);
+            channel.setDescription("Shows currently playing audio");
+            NotificationManager notificationManager = getSystemService(NotificationManager.class);
+            if (notificationManager != null) {
+                notificationManager.createNotificationChannel(channel);
+            }
+        }
+    }
+}
