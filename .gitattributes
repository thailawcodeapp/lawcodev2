# The law text in public/data/ is checksummed by
# src/data/corpus.integrity.test.js, which hashes working-tree bytes. Without
# this, autocrlf hands a different byte stream to every platform and the guard
# fails on files nobody touched.
public/data/*.json -text

# src/data/audio-manifest.json is generated by scripts/tts-render/render.mjs
# and compared byte for byte against a fresh regeneration by
# scripts/tts-render/corpus.test.mjs. render.mjs writes LF; without this,
# autocrlf hands back CRLF on checkout and the test fails on a file nobody
# edited. It passed in the tree where render.mjs had overwritten the file in
# place, and failed the moment anyone checked the repository out fresh.
src/data/audio-manifest.json -text
